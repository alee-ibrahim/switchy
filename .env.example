# Copy to .env for local development.
DATABASE_URL=postgres://switchy:switchy@localhost:55440/switchy
PORT=8090
LOG_LEVEL=info            # debug shows every DCen line
# NDI
# NDI_RUNTIME_DIR=C:\Program Files\NDI\NDI 6 Tools\Runtime   # only if not auto-detected
# NDI_EXTRA_IPS=192.0.2.10,192.0.2.11                 # extra unicast discovery targets
# NDI_AUTO_EXTRA_IPS=true   # also add every configured camera IP (default true)
# NDI_GROUPS=
# Auth: off (default) | proxy (behind an OIDC proxy that sets identity headers)
AUTH_MODE=off
# AUTH_ALLOWED_GROUPS=
# Camera credentials (only if a camera needs them; reference by name in the UI):
# SWITCHY_CRED_SONY_USERNAME=
# SWITCHY_CRED_SONY_PASSWORD=
